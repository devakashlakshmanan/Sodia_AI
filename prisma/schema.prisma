datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String               @id // Maps to Supabase auth user.id
  email                String               @unique
  fullName             String?
  avatarUrl            String?
  role                 String               @default("USER") // USER, ADMIN
  credits              Int                  @default(50) // Free monthly credits
  brandVoice           String?              @db.Text
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  stripeStatus         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspaceItems       SavedWorkspaceItem[]
  calendarEvents       CalendarEvent[]
}

model SavedWorkspaceItem {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentType      String          // TREND, RESEARCH, IDEA, CAPTION, HASHTAG, CONVERTER, IMAGE, PREDICTION
  title          String
  content        String          @db.Text // Stringified JSON holding agent-specific outputs
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  calendarEvents CalendarEvent[]
}

model CalendarEvent {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceItemId String?
  workspaceItem   SavedWorkspaceItem? @relation(fields: [workspaceItemId], references: [id], onDelete: SetNull)
  title           String
  content         String              @db.Text
  platforms       String              // Comma-separated social platforms: e.g. "x,linkedin,instagram"
  scheduledAt     DateTime
  status          String              @default("SCHEDULED") // SCHEDULED, PUBLISHED, FAILED
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model AnalyticsSnapshot {
  id        String   @id @default(uuid())
  userId    String
  platform  String   // x, linkedin, instagram, facebook, threads
  views     Int      @default(0)
  clicks    Int      @default(0)
  likes     Int      @default(0)
  shares    Int      @default(0)
  date      DateTime @default(now())
}
